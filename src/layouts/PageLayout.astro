---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  article?: { published: Date };
  // Use the title as-is, without the " | Tom Lowndes" suffix
  fullTitle?: boolean;
};

const { title, description, image, imageAlt, article, fullTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={fullTitle ? title : `${title} | ${SITE.NAME}`} description={description} image={image} imageAlt={imageAlt} article={article} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
