---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  article?: { published: Date };
  // Use the title as-is, without the " | Tom Lowndes" suffix
  fullTitle?: boolean;
  // Keep the page out of search results (e.g. form confirmation pages)
  noindex?: boolean;
};

const { title, description, image, imageAlt, article, fullTitle, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={fullTitle ? title : `${title} | ${SITE.NAME}`} description={description} image={image} imageAlt={imageAlt} article={article} noindex={noindex} />
  </head>
  <body>
    <!-- Stops Cloudflare's email obfuscation rewriting mailto links to /cdn-cgi/l/email-protection, which crawlers report as broken -->
    <!--email_off-->
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!--/email_off-->
  </body>
</html>
