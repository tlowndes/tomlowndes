---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  article?: { published: Date };
  // Use the title as-is, without the " | Tom Lowndes" suffix
  fullTitle?: boolean;
  // Keep the page out of search results (e.g. form confirmation pages)
  noindex?: boolean;
  jsonLd?: object;
};

const { title, description, image, imageAlt, article, fullTitle, noindex, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={fullTitle ? title : `${title} | ${SITE.NAME}`} description={description} image={image} imageAlt={imageAlt} article={article} noindex={noindex} jsonLd={jsonLd} />
  </head>
  <body>
    <!-- Stops Cloudflare's email obfuscation rewriting mailto links to /cdn-cgi/l/email-protection, which crawlers report as broken -->
    <!--email_off-->
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-black focus:px-3 focus:py-2 focus:text-sm focus:text-white dark:focus:bg-white dark:focus:text-black">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="focus:outline-none focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black dark:focus-visible:outline-white">
      <slot />
    </main>
    <Footer />
    <!--/email_off-->
  </body>
</html>
