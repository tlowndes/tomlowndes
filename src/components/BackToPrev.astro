---
type Props = {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  class="group inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-black/45 hover:text-black dark:text-white/45 dark:hover:text-white transition"
>
  <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">←</span>
  <slot/>
</a>
