---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  priority?: boolean;
  pictureClass?: string;
}

const {
  src,
  alt,
  class: className,
  sizes = "(min-width: 768px) 720px, 100vw",
  priority = false,
  pictureClass = "block w-full",
} = Astro.props;

const widths = [...new Set([480, 768, 1200, 1600, src.width].filter((width) => width > 0 && width <= src.width))].sort(
  (a, b) => a - b,
);
---

<Picture
  src={src}
  alt={alt}
  formats={["avif", "webp"]}
  fallbackFormat="webp"
  widths={widths}
  sizes={sizes}
  class={className}
  pictureAttributes={{ class: pictureClass }}
  loading={priority ? "eager" : "lazy"}
  decoding="async"
  priority={priority}
/>
