---
import { SITE, SOCIALS } from "@consts";

type Props = {
  title?: string;
};

const { title = "Let's connect" } = Astro.props;
---

<section class="animate space-y-3 border-t border-black/10 pt-8 dark:border-white/10">
  <h2 class="text-sm font-semibold text-black dark:text-white">
    {title}
  </h2>
  <p class="text-xs sm:text-sm text-black/75 dark:text-white/75">
    <slot>Hiring, collaborating or just want to say hi? Send me a message, drop me an email or find me on social media.</slot>
  </p>
  <ul class="flex flex-wrap gap-1.5">
    <li>
      <a
        href="/contact"
        class="inline-block rounded-full bg-black px-3.5 py-1 text-xs font-semibold text-white hover:opacity-80 dark:bg-white dark:text-black transition"
      >
        Send a message
      </a>
    </li>
    <li>
      <a
        href={`mailto:${SITE.EMAIL}`}
        class="inline-block rounded-full border border-black/15 px-3.5 py-1 text-xs font-semibold text-black/75 hover:border-black/40 hover:text-black dark:border-white/15 dark:text-white/75 dark:hover:border-white/40 dark:hover:text-white transition"
      >
        {SITE.EMAIL}
      </a>
    </li>
    {SOCIALS.map((SOCIAL) => (
      <li>
        <a
          href={SOCIAL.HREF}
          target="_blank"
          rel="noopener noreferrer me"
          aria-label={`${SITE.NAME} on ${SOCIAL.NAME} (opens in a new tab)`}
          class="inline-block rounded-full border border-black/15 px-3 py-1 font-mono text-[11px] text-black/65 hover:border-black/40 hover:text-black dark:border-white/15 dark:text-white/65 dark:hover:border-white/40 dark:hover:text-white transition"
        >
          {SOCIAL.NAME} ↗
        </a>
      </li>
    ))}
  </ul>
</section>
