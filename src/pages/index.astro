---
import { type CollectionEntry, getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ContactBlock from "@components/ContactBlock.astro";
import { byDateDesc, dateRange, readingTime as getReadingTime } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";
import { PERSON_ID } from "@lib/schema";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort(byDateDesc)
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

// Frontmatter image first, then the first markdown image in the body
function getImage(entry: CollectionEntry<"projects">) {
  const bodyMatch = entry.body ? entry.body.match(/!\[.*?\]\((.*?)\)/) : null;
  return entry.data.image || (bodyMatch ? bodyMatch[1] : null);
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://tomlowndes.co.uk/#business",
  name: "Tom Lowndes",
  url: "https://tomlowndes.co.uk/",
  logo: "https://tomlowndes.co.uk/og-default.png",
  image: "https://tomlowndes.co.uk/tom-headshot.jpg",
  founder: { "@id": PERSON_ID },
  sameAs: SOCIALS.map((s) => s.HREF),
  description: HOME.DESCRIPTION,
  address: { "@type": "PostalAddress", addressLocality: "Cannock", addressRegion: "Staffordshire", addressCountry: "GB" },
  areaServed: ["Cannock", "Hednesford", "Rugeley", "Lichfield", "Stafford", "Walsall"].map((name) => ({ "@type": "City", name })),
  knowsAbout: ["App design", "UI design", "Branding", "Web design", "Social graphics"],
};

const shortDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { year: "numeric", month: "short" });
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} fullTitle>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Container>
    <div class="space-y-14">
      <!-- Header -->
      <section class="animate space-y-5 border-b border-black/10 dark:border-white/10 pb-8">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="font-mono text-[11px] uppercase tracking-widest text-black/65 dark:text-white/65">
            Design lead // Cannock, Staffordshire
          </span>
          <a
            href="#available"
            class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[10px] text-emerald-700 dark:text-emerald-300 hover:border-emerald-500/60 transition"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 motion-safe:animate-pulse"></span>
            <span>Open to in-house and remote roles</span>
          </a>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row-reverse sm:items-start sm:gap-6">
          <img
            src="/tom-headshot.jpg"
            alt="Tom Lowndes"
            width="128"
            height="128"
            loading="eager"
            class="h-20 w-20 sm:h-32 sm:w-32 shrink-0 rounded-2xl object-cover shadow-sm ring-1 ring-black/10 dark:ring-white/15"
          />
          <div class="flex-1 space-y-3">
            <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-black dark:text-white">
              Design lead in Cannock, Staffordshire. <span class="font-serif italic font-normal text-black/65 dark:text-white/65">Open to in-house and remote design roles.</span>
            </h1>
            <p class="text-sm text-black/75 dark:text-white/75 leading-relaxed">
              App and UI design, branding, websites and social graphics. I work with local businesses and remote teams.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a
                href="/contact/?reason=freelance"
                class="rounded-full bg-black text-white dark:bg-white dark:text-black px-4 py-1.5 text-xs font-semibold hover:opacity-80 transition"
              >
                Get a quote
              </a>
              <a
                href="/cv/"
                class="rounded-full border border-black/15 dark:border-white/15 px-4 py-1.5 text-xs font-semibold text-black dark:text-white hover:border-black/40 dark:hover:border-white/40 transition"
              >
                View my CV
              </a>
            </div>
            <a
              href="/contact/?reason=freelance"
              class="inline-block font-mono text-[11px] text-black/65 dark:text-white/65 hover:text-black dark:hover:text-white transition"
            >
              Freelance enquiries →
            </a>
          </div>
        </div>
      </section>

      <!-- Looking for a role -->
      <section id="available" class="animate scroll-mt-8">
        <div class="rounded-2xl border border-black/10 bg-white/80 p-5 sm:p-6 shadow-sm dark:border-white/10 dark:bg-neutral-900/60 space-y-4">
          <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-wider text-black/65 dark:text-white/65">
            <span>Status // Looking for my next role</span>
            <span class="text-emerald-700 dark:text-emerald-400">Available</span>
          </div>
          <div class="space-y-2">
            <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-black dark:text-white">
              I'm looking for a design role with a calm, intentional team.
            </h2>
            <p class="text-sm text-black/70 dark:text-white/70 leading-relaxed">
              Ideally remote, though the right in-house team is just as welcome. I do my best work where deep focus is protected, asynchronous communication is respected, and good design comes from thoughtful problem-solving rather than back-to-back meetings.
            </p>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {["Brand & identity", "Print & production", "Web & digital", "Video & photography"].map((skill) => (
              <span class="rounded bg-black/5 dark:bg-white/10 px-2 py-0.5 font-mono text-[10px] text-black/70 dark:text-white/70">
                {skill}
              </span>
            ))}
          </div>
          <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-black/10 dark:border-white/10">
            <a
              href="/contact/"
              class="rounded-full bg-black text-white dark:bg-white dark:text-black px-4 py-1.5 text-xs font-semibold hover:opacity-80 transition"
            >
              Get in touch
            </a>
            <a
              href="/projects/"
              class="rounded-full border border-black/15 dark:border-white/15 px-4 py-1.5 text-xs font-semibold text-black dark:text-white hover:border-black/40 dark:hover:border-white/40 transition"
            >
              See my work
            </a>
            <a
              href="https://www.behance.net/tomlowndes"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="View my design portfolio on Behance (opens in a new tab)"
              class="font-mono text-[11px] text-black/65 dark:text-white/65 hover:text-black dark:hover:text-white transition"
            >
              Behance ↗
            </a>
          </div>
        </div>
      </section>

      <!-- Selected work -->
      <section class="animate space-y-4">
        <div class="flex items-center gap-3">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-black/70 dark:text-white/70">
            01. Selected Work
          </h2>
          <div class="h-px flex-1 bg-black/10 dark:bg-white/10"></div>
          <a href="/projects/" class="font-mono text-[11px] text-black/65 dark:text-white/65 hover:text-black dark:hover:text-white transition">
            All projects →
          </a>
        </div>
        <ul class="grid gap-4 sm:grid-cols-3">
          {projects.map((project) => {
            const image = getImage(project);
            return (
              <li>
                <a
                  href={`/projects/${project.slug}/`}
                  class="group flex h-full flex-col overflow-hidden rounded-xl border border-black/10 bg-white/60 transition-all duration-200 hover:-translate-y-0.5 hover:border-black/25 hover:bg-white dark:border-white/10 dark:bg-neutral-900/40 dark:hover:border-white/25 dark:hover:bg-neutral-900/80"
                >
                  <div class="aspect-[4/3] w-full overflow-hidden bg-gradient-to-br from-neutral-800 via-neutral-900 to-neutral-950 border-b border-black/5 dark:border-white/5">
                    {image && (
                      <img
                        src={image}
                        alt=""
                        loading="lazy"
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    )}
                  </div>
                  <div class="flex flex-1 flex-col p-3.5 space-y-1">
                    <span class="font-mono text-[10px] text-black/65 dark:text-white/65">
                      {shortDate(project.data.date)}
                    </span>
                    <h3 class="text-sm font-semibold text-black dark:text-white group-hover:underline underline-offset-4">
                      {project.data.title}
                    </h3>
                    <p class="text-xs text-black/65 dark:text-white/65 line-clamp-2 leading-relaxed">
                      {project.data.description}
                    </p>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>

      <!-- Latest notes -->
      <section class="animate space-y-4">
        <div class="flex items-center gap-3">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-black/70 dark:text-white/70">
            02. Field Notes
          </h2>
          <div class="h-px flex-1 bg-black/10 dark:bg-white/10"></div>
          <a href="/blog/" class="font-mono text-[11px] text-black/65 dark:text-white/65 hover:text-black dark:hover:text-white transition">
            All posts →
          </a>
        </div>
        <ul class="flex flex-col gap-3">
          {blog.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}/`}
                class="group flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 rounded-xl border border-black/10 bg-white/60 p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-black/25 hover:bg-white hover:shadow-sm dark:border-white/10 dark:bg-neutral-900/40 dark:hover:border-white/25 dark:hover:bg-neutral-900/80"
              >
                <div class="space-y-1 pr-2">
                  <h3 class="font-semibold text-base text-black dark:text-white group-hover:underline underline-offset-4">
                    {post.data.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-black/65 dark:text-white/65 line-clamp-2 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>
                <div class="flex sm:flex-col items-center sm:items-end justify-between shrink-0 gap-1 font-mono text-[11px] text-black/65 dark:text-white/65 pt-2 sm:pt-0 border-t sm:border-t-0 border-black/5 dark:border-white/5">
                  <span>
                    {post.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit" })}
                  </span>
                  <span class="text-[10px]">{getReadingTime(post.body)}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Experience -->
      <section class="animate space-y-4">
        <div class="flex items-center gap-3">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-black/70 dark:text-white/70">
            03. Experience
          </h2>
          <div class="h-px flex-1 bg-black/10 dark:bg-white/10"></div>
        </div>
        <ol class="space-y-6 border-l border-black/10 dark:border-white/10 pl-5">
          {work.map((entry) => (
            <li class="relative space-y-1.5">
              <span class="absolute -left-[25px] top-1.5 h-2 w-2 rounded-full border border-black/30 bg-white dark:border-white/30 dark:bg-neutral-900"></span>
              <div class="font-mono text-[11px] text-black/65 dark:text-white/65">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.role} <span class="font-normal text-black/65 dark:text-white/65">at</span> {entry.data.company}
              </div>
              <article class="text-sm text-black/70 dark:text-white/70 leading-relaxed">
                <entry.Content />
              </article>
            </li>
          ))}
        </ol>
        <div class="rounded-xl border border-black/10 bg-black/[0.02] p-4 dark:border-white/10 dark:bg-white/[0.02] space-y-2">
          <span class="font-mono text-[10px] uppercase tracking-wider text-black/65 dark:text-white/65">
            Along the way
          </span>
          <ul class="list-disc pl-5 space-y-1 text-sm text-black/70 dark:text-white/70">
            <li>Worked on large corporate documents</li>
            <li>Designed countless banners, posters and leaflets for over 350 European nurseries</li>
            <li>Filmed and edited adverts for social media</li>
            <li>Filmed and edited an online company awards show during lockdown</li>
          </ul>
        </div>
      </section>

      <ContactBlock />
    </div>
  </Container>
</PageLayout>
