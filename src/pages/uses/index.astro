---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import Link from "@components/Link.astro";
import { SITE, SOCIALS } from "@consts";

const USES = {
  TITLE: "Uses",
  DESCRIPTION: "A living index of the physical hardware, everyday carry, digital tools, and self-hosted infrastructure I use daily.",
};

const allGear = (await getCollection("uses", ({ data }) => !data.draft));

const categories = [
  { key: "carry", label: "01. On-Body Carry & The Split Rig" },
  { key: "sensory", label: "02. Sensory Protection & Working Memory" },
  { key: "utility", label: "03. The Utility Rig (Daily Hardware)" },
  { key: "digital", label: "04. Digital Workspace & Terminal" },
  { key: "security", label: "05. Security, Cloud & Network" },
  { key: "homelab", label: "06. Homelab & Infrastructure" },
];
---

<PageLayout title={USES.TITLE} description={USES.DESCRIPTION}>
  <Container>
    <div class="animate mb-8">
      <BackToPrev href="/">
        Back to home
      </BackToPrev>
    </div>

    <div class="space-y-12">
      <!-- Header -->
      <section class="animate space-y-4 border-b border-black/10 pb-8 dark:border-white/10">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px] uppercase tracking-widest text-black/50 dark:text-white/50">
            Mise-en-Place // {allGear.length} Items Catalogued
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[10px] text-emerald-700 dark:text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Living Directory</span>
          </span>
        </div>

        <div class="space-y-2">
          <h1 class="text-2xl font-semibold tracking-tight text-black sm:text-3xl dark:text-white">
            Tools, tech, and gear I use daily.
          </h1>
          <p class="max-w-2xl text-sm leading-relaxed text-black/75 dark:text-white/75">
            As a creative designer with an AuDHD brain, my setup is engineered around friction reduction: eliminating cognitive dropouts, protecting auditory bandwidth, offloading working memory to physical paper, and keeping systems autonomous.
          </p>
        </div>

        <!-- Live Search -->
        <div class="pt-2">
          <input
            id="uses-search-input"
            type="search"
            placeholder="Search items by name, role, or spec..."
            oninput="window.filterUsesList()"
            class="w-full max-w-sm rounded-xl border border-black/10 bg-white/80 px-3.5 py-2 text-xs text-black placeholder:text-black/40 transition focus:border-black/30 focus:outline-none dark:border-white/10 dark:bg-neutral-900/70 dark:text-white dark:placeholder:text-white/40 dark:focus:border-white/30"
          />
        </div>
      </section>

      <!-- Category Groups -->
      <div class="space-y-14" id="gear-groups">
        {categories.map((cat) => {
          const items = allGear.filter((g) => g.data.category === cat.key);
          if (items.length === 0) return null;

          return (
            <section class="space-y-4 gear-category" data-cat={cat.key}>
              <div class="flex items-baseline justify-between border-b border-black/10 pb-2 dark:border-white/10">
                <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-black/70 dark:text-white/70">
                  {cat.label}
                </h2>
                <span class="font-mono text-[10px] text-black/40 dark:text-white/40">
                  {items.length} {items.length === 1 ? "item" : "items"}
                </span>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                {items.map((item) => (
                  <a
                    href={`/uses/${item.slug}`}
                    data-search={`${item.data.title} ${item.data.role} ${item.data.badge} ${item.data.why}`.toLowerCase()}
                    class="gear-item group flex flex-col justify-between overflow-hidden rounded-xl border border-black/10 bg-white/60 transition-all duration-200 hover:-translate-y-0.5 hover:border-black/25 hover:bg-white dark:border-white/10 dark:bg-neutral-900/40 dark:hover:border-white/25 dark:hover:bg-neutral-900/80"
                  >
                    {item.data.image && (
                      <div class="aspect-video w-full overflow-hidden bg-neutral-900 border-b border-black/5 dark:border-white/5">
                        <img
                          src={item.data.image}
                          alt={item.data.title}
                          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        />
                      </div>
                    )}

                    <div class="p-4 space-y-2">
                      <div class="flex items-center justify-between font-mono text-[10px] text-black/50 dark:text-white/50">
                        <span>{item.data.role}</span>
                        <span class="rounded bg-black/5 px-1.5 py-0.5 dark:bg-white/10">{item.data.badge}</span>
                      </div>

                      <h3 class="text-base font-semibold tracking-tight text-black transition group-hover:underline underline-offset-4 dark:text-white">
                        {item.data.title}
                      </h3>

                      <p class="text-xs leading-relaxed text-black/70 line-clamp-2 dark:text-white/70">
                        {item.data.why}
                      </p>
                    </div>

                    <div class="px-4 pb-3 pt-1 flex items-center justify-end font-mono text-[11px] text-black/40 group-hover:text-black dark:text-white/40 dark:group-hover:text-white transition">
                      <span>Read notes →</span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </div>

      <!-- Social / Contact Footer -->
      <section class="space-y-4 border-t border-black/10 pt-8 dark:border-white/10">
        <h3 class="text-sm font-semibold text-black dark:text-white">
          Curious about a specific tool or configuration?
        </h3>
        <p class="text-xs text-black/75 sm:text-sm dark:text-white/75">
          Reach out if you'd like a config breakdown, a copy of the offline HTML terminal boilerplate, or to discuss systems architecture.
        </p>
        <ul class="flex flex-wrap gap-2 text-xs">
          {SOCIALS.map((SOCIAL) => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>

<script is:inline>
  window.filterUsesList = function() {
    const query = (document.getElementById('uses-search-input')?.value || '').toLowerCase().trim();
    const items = document.querySelectorAll('.gear-item');
    const categories = document.querySelectorAll('.gear-category');

    items.forEach(el => {
      const text = el.getAttribute('data-search') || '';
      el.style.display = (!query || text.includes(query)) ? '' : 'none';
    });

    categories.forEach(cat => {
      const visible = cat.querySelectorAll('.gear-item:not([style*="display: none"])').length;
      cat.style.display = visible > 0 ? '' : 'none';
    });
  };
</script>