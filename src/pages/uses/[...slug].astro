---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import { assetFor } from "@lib/images";
import ContentPicture from "@components/ContentPicture.astro";
import { articleSchema } from "@lib/schema";

export async function getStaticPaths() {
  const items = await getCollection("uses", ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

type Props = {
  item: CollectionEntry<"uses">;
};

const { item } = Astro.props;
const { Content } = await render(item);
const hero = assetFor(item.filePath, item.data.image);

// Supports either 'buyLink' or 'link' from frontmatter
const purchaseUrl = item.data.buyLink || item.data.link;
const purchaseText = item.data.buyLabel || "Buy / View Product";
const jsonLd = articleSchema({
  type: "WebPage",
  url: new URL(Astro.url.pathname, Astro.site).href,
  headline: item.data.metaTitle ?? item.data.title,
  description: item.data.description ?? item.data.why,
  image: new URL(hero?.src ?? "/og-default.png", Astro.site).href,
  about: item.data.metaTitle ?? item.data.title,
});
---

<PageLayout title={`${item.data.metaTitle ?? item.data.title} | Uses`} description={item.data.description ?? item.data.why} jsonLd={jsonLd}>
  <Container>
    <div class="animate mb-8">
      <BackToPrev href="/uses/">
        Back to Uses
      </BackToPrev>
    </div>

    <div class="animate space-y-8">
      <!-- Top Spec Card -->
      <div class="rounded-2xl border border-black/10 bg-white/80 p-6 sm:p-8 shadow-sm dark:border-white/10 dark:bg-neutral-900/60 space-y-6">
        
        <!-- Top Status Bar -->
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-black/10 pb-4 dark:border-white/10">
          <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-black/65 dark:text-white/65">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            <span>{item.data.category}</span>
            <span>//</span>
            <span>{item.data.role}</span>
          </div>
          <span class="rounded-md border border-black/10 bg-black/[0.03] px-2.5 py-1 font-mono text-xs text-black/80 dark:border-white/10 dark:bg-white/[0.06] dark:text-white/80">
            {item.data.badge}
          </span>
        </div>

        <!-- Title -->
        <div class="space-y-2">
          <h1 class="text-2xl sm:text-4xl font-semibold tracking-tight text-black dark:text-white">
            {item.data.title}
          </h1>
        </div>

        <!-- Optional Hero Image -->
        {hero && (
          <div class="overflow-hidden rounded-xl border border-black/10 bg-neutral-950 ring-1 ring-black/5 dark:border-white/10 dark:ring-white/10">
            <ContentPicture
              src={hero}
              alt={item.data.title}
              sizes="(min-width: 768px) 720px, 100vw"
              class="h-auto max-h-[440px] w-full object-cover"
            />
          </div>
        )}

        <!-- 3-Column Spec Metadata Strip -->
        <div class="grid gap-3 sm:grid-cols-3 rounded-xl border border-black/10 bg-black/[0.02] p-4 text-xs dark:border-white/10 dark:bg-white/[0.03]">
          <div>
            <span class="block font-mono text-[10px] uppercase tracking-wider text-black/65 dark:text-white/65">
              01 // Category
            </span>
            <strong class="mt-0.5 block font-mono uppercase text-black dark:text-white">
              {item.data.category}
            </strong>
          </div>
          <div>
            <span class="block font-mono text-[10px] uppercase tracking-wider text-black/65 dark:text-white/65">
              02 // System Role
            </span>
            <strong class="mt-0.5 block font-medium text-black dark:text-white">
              {item.data.role}
            </strong>
          </div>
          <div>
            <span class="block font-mono text-[10px] uppercase tracking-wider text-black/65 dark:text-white/65">
              03 // Key Spec
            </span>
            <strong class="mt-0.5 block font-medium text-black dark:text-white">
              {item.data.badge}
            </strong>
          </div>
        </div>

        <!-- Friction-Reduction Callout (Description) -->
        <div class="rounded-xl border-l-2 border-emerald-500 bg-emerald-500/[0.06] p-4 dark:bg-emerald-500/[0.08]">
          <span class="block font-mono text-[10px] uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
            Why It's In The Stack // Friction Reduction
          </span>
          <p class="mt-1 text-sm font-medium leading-relaxed text-black/90 dark:text-white/90">
            {item.data.why}
          </p>
        </div>

        <!-- Optional Buy Link Section (Hidden automatically if buyLink is omitted) -->
        {purchaseUrl && (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-xl border border-black/10 bg-black/[0.02] px-4 py-3.5 dark:border-white/10 dark:bg-white/[0.03]">
            <div class="space-y-0.5">
              <span class="block font-mono text-[10px] uppercase tracking-wider text-black/65 dark:text-white/65">
                Source // Acquisition
              </span>
              <span class="text-xs text-black/75 dark:text-white/75">
                Check current specs, pricing, or availability.
              </span>
            </div>
            <a
              href={purchaseUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-black px-4 py-2 font-mono text-xs font-medium text-white shadow-sm transition hover:bg-neutral-800 dark:bg-white dark:text-black dark:hover:bg-neutral-200 shrink-0"
            >
              <span>{purchaseText}</span>
              <span>↗</span>
            </a>
          </div>
        )}
      </div>

      <!-- Deep-Dive Markdown Content Box -->
      <div class="rounded-2xl border border-black/10 bg-white/50 p-6 sm:p-8 dark:border-white/10 dark:bg-neutral-900/30">
        <div class="mb-4 border-b border-black/10 pb-2 font-mono text-[11px] uppercase tracking-wider text-black/65 dark:border-white/10 dark:text-white/65">
          System Notes & Configuration
        </div>
        <div class="prose prose-neutral dark:prose-invert max-w-none text-sm leading-relaxed">
          <Content />
        </div>
      </div>
    </div>
  </Container>
</PageLayout>
