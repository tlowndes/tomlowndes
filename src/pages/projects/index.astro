---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import { PROJECTS } from "@consts";
import { byDateDesc } from "@lib/utils";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort(byDateDesc);

const projectsData = projects.map((p, index) => {
  // Check frontmatter 'image' first, or fallback to the first markdown image in the body
  const bodyImageMatch = p.body ? p.body.match(/!\[.*?\]\((.*?)\)/) : null;
  const resolvedImage = p.data.image || (bodyImageMatch ? bodyImageMatch[1] : null);

  // Strip markdown formatting for a clean popup preview text
  const cleanExcerpt = p.body
    ? p.body
        .replace(/!\[.*?\]\(.*?\)/g, "")
        .replace(/[#*`>_~[\]()!-]/g, " ")
        .replace(/\s+/g, " ")
        .trim()
        .slice(0, 280) + "..."
    : p.data.description;

  return {
    id: p.id,
    indexNum: String(index + 1).padStart(2, "0"),
    url: `/projects/${p.id}/`,
    title: p.data.title,
    description: p.data.description,
    image: resolvedImage,
    excerpt: cleanExcerpt,
    date: p.data.date.toLocaleDateString("en-GB", {
      year: "numeric",
      month: "short",
    }),
    demoURL: p.data.demoURL || null,
    repoURL: p.data.repoURL || null,
    isFeatured: index === 0,
  };
});
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="animate mb-8">
      <BackToPrev href="/">
        Back to home
      </BackToPrev>
    </div>

    <div class="space-y-10">
      <!-- Page Header -->
      <section class="animate space-y-4 border-b border-black/10 dark:border-white/10 pb-8">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-mono text-emerald-700 dark:text-emerald-300">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 motion-safe:animate-pulse"></span>
          <span>Available for remote & in-house design roles</span>
        </div>

        <div class="space-y-2">
          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-black dark:text-white">
            Selected <span class="font-serif italic font-normal text-black/65 dark:text-white/65">Work.</span>
          </h1>
          <p class="text-sm text-black/70 dark:text-white/70 leading-relaxed">
            Commercial design, brand systems, print production, and digital interfaces. Click any project for a quick overview or to read the full case study.
          </p>
        </div>
      </section>

      <!-- Dynamic Projects Grid -->
      <section class="animate grid gap-5 sm:grid-cols-2">
        {projectsData.map((project) =>
          project.isFeatured ? (
            /* NEWEST PROJECT: FULL-WIDTH FEATURED TILE */
            <a
              href={project.url}
              onclick={`return window.openProjectModal(event, '${project.id}')`}
              class="sm:col-span-2 group rounded-2xl border border-black/10 bg-white/80 p-4 sm:p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-black/25 hover:shadow-lg dark:border-white/10 dark:bg-neutral-900/60 dark:hover:border-white/25 space-y-4"
            >
              <div class="relative aspect-[16/9] w-full overflow-hidden rounded-xl bg-neutral-900 ring-1 ring-black/10 dark:ring-white/10 flex flex-col justify-between p-5 text-white bg-gradient-to-br from-neutral-900 via-neutral-800 to-neutral-950">
                {project.image && (
                  <>
                    <img
                      src={project.image}
                      alt={project.title}
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/40" />
                  </>
                )}

                <div class="relative z-10 flex items-center justify-between">
                  <span class="rounded bg-black/60 text-emerald-300 backdrop-blur-md px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider">
                    Featured Project
                  </span>
                  <span class="rounded bg-black/50 backdrop-blur-md px-2 py-0.5 font-mono text-[11px] text-white/80">
                    {project.indexNum} // {project.date}
                  </span>
                </div>

                {!project.image && (
                  <div class="relative z-10 my-auto max-w-lg space-y-2 py-2 transition-transform duration-500 group-hover:translate-x-1">
                    <div class="h-1.5 w-10 rounded bg-emerald-400"></div>
                    <div class="text-xl sm:text-2xl font-bold tracking-tight text-white">
                      {project.title}
                    </div>
                    <p class="text-xs sm:text-sm text-white/70 line-clamp-2">
                      {project.description}
                    </p>
                  </div>
                )}

                <div class="relative z-10 flex items-center justify-between text-xs text-white/80 mt-auto">
                  <span class="font-mono text-[11px] drop-shadow">Case Study</span>
                  <span class="rounded-full bg-white text-black px-3 py-1 text-[11px] font-semibold shadow group-hover:bg-emerald-400 transition">
                    Quick View ↗
                  </span>
                </div>
              </div>

              <div class="flex items-center justify-between px-1">
                <div>
                  <h2 class="text-lg font-semibold text-black dark:text-white group-hover:underline underline-offset-4">
                    {project.title}
                  </h2>
                  <p class="text-xs text-black/65 dark:text-white/65">
                    {project.description}
                  </p>
                </div>
                <span class="font-mono text-xs text-black/65 dark:text-white/65 group-hover:text-black dark:group-hover:text-white">
                  →
                </span>
              </div>
            </a>
          ) : (
            /* STANDARD 2-COLUMN GRID TILE */
            <a
              href={project.url}
              onclick={`return window.openProjectModal(event, '${project.id}')`}
              class="group rounded-2xl border border-black/10 bg-white/80 p-4 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-black/25 hover:shadow-lg dark:border-white/10 dark:bg-neutral-900/60 dark:hover:border-white/25 flex flex-col justify-between space-y-4"
            >
              <div class="space-y-3.5">
                <div class="relative aspect-[4/3] w-full overflow-hidden rounded-xl bg-neutral-900 p-4 flex flex-col justify-between text-white ring-1 ring-black/5 dark:ring-white/10 bg-gradient-to-br from-neutral-800 via-neutral-900 to-neutral-950">
                  {project.image && (
                    <>
                      <img
                        src={project.image}
                        alt={project.title}
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-black/40" />
                    </>
                  )}

                  <div class="relative z-10 flex justify-between items-center font-mono text-[10px] text-white/80">
                    <span class="rounded bg-black/50 backdrop-blur-md px-2 py-0.5">
                      PROJECT // {project.indexNum}
                    </span>
                    <span class="rounded bg-black/50 backdrop-blur-md px-2 py-0.5">
                      {project.date}
                    </span>
                  </div>

                  {!project.image && (
                    <div class="relative z-10 my-auto space-y-1 border-l-2 border-white/30 pl-3 transition-transform duration-500 group-hover:translate-x-1">
                      <div class="text-base font-bold text-white line-clamp-2">
                        {project.title}
                      </div>
                    </div>
                  )}

                  <div class="relative z-10 flex justify-end mt-auto">
                    <span class="rounded-full bg-white text-black px-2.5 py-0.5 text-[10px] font-semibold shadow">
                      Quick View ↗
                    </span>
                  </div>
                </div>

                <div class="px-0.5 space-y-1">
                  <h2 class="text-base font-semibold text-black dark:text-white group-hover:underline underline-offset-4">
                    {project.title}
                  </h2>
                  <p class="text-xs text-black/70 dark:text-white/70 line-clamp-2 leading-relaxed">
                    {project.description}
                  </p>
                </div>
              </div>

              <div class="pt-2 border-t border-black/10 dark:border-white/10 flex items-center justify-between text-[10px] font-mono text-black/65 dark:text-white/65">
                <span>{project.date}</span>
                <span>Inspect ↗</span>
              </div>
            </a>
          )
        )}
      </section>
    </div>
  </Container>

  <!-- ========================================== -->
  <!-- QUICK-VIEW POPUP MODAL                     -->
  <!-- ========================================== -->
  <dialog id="project-modal" class="w-[92vw] max-w-xl rounded-2xl border border-black/15 bg-[#FAF9F6] p-0 text-black shadow-2xl dark:border-white/15 dark:bg-[#121215] dark:text-white overflow-hidden">
    <div class="flex items-center justify-between border-b border-black/10 px-5 py-3.5 dark:border-white/10 bg-white/60 dark:bg-black/20 backdrop-blur">
      <span id="modal-date" class="font-mono text-[11px] text-black/65 dark:text-white/65"></span>
      <button
        onclick="window.closeProjectModal()"
        aria-label="Close"
        class="rounded-lg border border-black/10 bg-black/[0.03] px-2.5 py-1 text-xs font-mono hover:bg-black/10 dark:border-white/10 dark:bg-white/[0.05] dark:hover:bg-white/15 transition"
      >
        ESC ✕
      </button>
    </div>

    <div class="p-5 sm:p-6 space-y-5 max-h-[80vh] overflow-y-auto">
      <!-- Modal Thumbnail Image -->
      <div id="modal-image-wrapper" class="hidden aspect-video w-full overflow-hidden rounded-xl bg-neutral-900 ring-1 ring-black/10 dark:ring-white/10">
        <img id="modal-image" src="" alt="" class="h-full w-full object-cover" />
      </div>

      <div class="space-y-1">
        <h3 id="modal-title" class="text-xl font-semibold tracking-tight"></h3>
        <p id="modal-desc" class="text-xs text-black/60 dark:text-white/60"></p>
      </div>

      <div class="rounded-xl border border-black/10 bg-black/[0.02] p-4 dark:border-white/10 dark:bg-white/[0.02] space-y-1.5">
        <span class="font-mono text-[10px] uppercase tracking-wider text-black/65 dark:text-white/65">
          Case Study Preview
        </span>
        <p id="modal-excerpt" class="text-sm text-black/80 dark:text-white/80 leading-relaxed"></p>
      </div>

      <div id="modal-links" class="hidden flex-wrap gap-3 text-xs font-mono"></div>

      <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-black/10 dark:border-white/10">
        <button
          onclick="window.closeProjectModal()"
          class="rounded-xl px-3.5 py-2 text-xs font-medium text-black/60 hover:text-black dark:text-white/60 dark:hover:text-white transition"
        >
          Keep Browsing
        </button>
        <a
          id="modal-full-link"
          href="/projects/"
          class="inline-flex items-center gap-1.5 rounded-xl bg-black px-4 py-2 text-xs font-semibold text-white shadow-md hover:bg-neutral-800 dark:bg-white dark:text-black dark:hover:bg-neutral-200 transition"
        >
          <span>Read Full Project</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </dialog>
</PageLayout>

<style>
  dialog::backdrop {
    background: rgba(5, 5, 7, 0.8);
    backdrop-filter: blur(6px);
  }
  dialog[open] {
    animation: modalSlideUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes modalSlideUp {
    from { opacity: 0; transform: translateY(10px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script
  type="application/json"
  id="projects-data"
  set:html={JSON.stringify(projectsData).replace(/</g, "\\u003c")}
></script>
<script is:inline>
  const projectsData = JSON.parse(document.getElementById("projects-data").textContent);
  window.PROJECT_MAP = {};
  if (Array.isArray(projectsData)) {
    projectsData.forEach((p) => {
      window.PROJECT_MAP[p.id] = p;
    });
  }

  window.openProjectModal = function(event, id) {
    // Let new-tab / new-window clicks follow the link as normal
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return true;
    const p = window.PROJECT_MAP[id];
    const modal = document.getElementById("project-modal");
    if (!p || !modal) return true;

    document.getElementById("modal-date").textContent = `PROJECT // ${p.indexNum} • ${p.date}`;
    document.getElementById("modal-title").textContent = p.title;
    document.getElementById("modal-desc").textContent = p.description;
    document.getElementById("modal-excerpt").textContent = p.excerpt;
    document.getElementById("modal-full-link").href = p.url;

    const imgWrapper = document.getElementById("modal-image-wrapper");
    const imgEl = document.getElementById("modal-image");
    if (p.image && imgWrapper && imgEl) {
      imgEl.src = p.image;
      imgEl.alt = p.title;
      imgWrapper.classList.remove("hidden");
    } else if (imgWrapper) {
      imgWrapper.classList.add("hidden");
    }

    const linksBox = document.getElementById("modal-links");
    linksBox.innerHTML = "";
    if (p.demoURL || p.repoURL) {
      linksBox.classList.remove("hidden");
      linksBox.classList.add("flex");
      // Built with the DOM rather than an HTML string, so crawlers don't read
      // the placeholder as a relative link.
      const addLink = (url, label) => {
        const a = document.createElement("a");
        a.href = url;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.className = "underline underline-offset-4 hover:text-emerald-500";
        a.textContent = label;
        linksBox.appendChild(a);
      };
      if (p.demoURL) addLink(p.demoURL, "Live Demo ↗");
      if (p.repoURL) addLink(p.repoURL, "Source / Repo ↗");
    } else {
      linksBox.classList.add("hidden");
    }

    modal.showModal();
    return false;
  };

  window.closeProjectModal = function() {
    const modal = document.getElementById("project-modal");
    if (modal) modal.close();
  };

  function setupModalClose() {
    const modal = document.getElementById("project-modal");
    if (modal) {
      modal.addEventListener("click", (e) => {
        const rect = modal.getBoundingClientRect();
        const clickedInDialog = (
          rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX && e.clientX <= rect.left + rect.width
        );
        if (!clickedInDialog) modal.close();
      });
    }
  }

  document.addEventListener("astro:page-load", setupModalClose);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupModalClose);
  } else {
    setupModalClose();
  }
</script>