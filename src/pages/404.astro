---
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="Page not found" description="This page doesn't exist or has moved. Head back to the homepage to find Tom Lowndes' projects, blog posts, CV and contact details." noindex>
  <Container>
    <div class="animate mb-8">
      <BackToPrev href="/">
        Back to home
      </BackToPrev>
    </div>
    <section class="animate space-y-5">
      <span class="font-mono text-[11px] uppercase tracking-widest text-black/45 dark:text-white/45">
        Error // 404
      </span>
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-black dark:text-white">
        Page not found <span class="font-serif italic font-normal text-black/65 dark:text-white/65">it may have moved.</span>
      </h1>
      <p class="text-black/75 dark:text-white/75">
        Try the <a href="/projects/" class="underline underline-offset-2">projects</a>, the <a href="/blog/" class="underline underline-offset-2">blog</a> or <a href="/contact/" class="underline underline-offset-2">get in touch</a>.
      </p>
    </section>
  </Container>
</PageLayout>
