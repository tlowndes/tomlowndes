---
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import PageLayout from "@layouts/PageLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";

import { SERVICES } from "@consts";

// Draft: hidden from the nav, sitemap and search. To publish, remove `noindex` below,
// the sitemap filter in astro.config.mjs, and re-add the Services link in Header.astro.
const QUOTE_HREF = "/contact/?reason=freelance";

const services = [
  {
    letter: "A",
    title: "App and UI design",
    blurb: "Screens and flows for a new app, or a tidy-up of an existing one, ready for developers.",
    includes: ["User flows and wireframes", "Designed screens in Figma", "Developer handoff"],
    price: "£1,500",
  },
  {
    letter: "B",
    title: "Branding",
    blurb: "A logo and a simple identity you can use everywhere, from signage to social.",
    includes: ["Logo and colours", "Typography and usage guide", "Print and screen files"],
    price: "£750",
  },
  {
    letter: "C",
    title: "Websites",
    blurb: "A fast, clear site for your business, designed and built to match your brand.",
    includes: ["Up to five pages", "Mobile-friendly", "Basic SEO and launch support"],
    price: "£1,000",
  },
  {
    letter: "D",
    title: "Social graphics",
    blurb: "Templates and post designs that keep your feed looking consistent.",
    includes: ["Branded post templates", "Story and cover formats", "Editable files"],
    price: "£250",
  },
];

const steps = [
  { label: "Brief", text: "Tell me what you need through the contact form." },
  { label: "Quote", text: "You get a fixed price and timescale before any work starts." },
  { label: "Design", text: "Two rounds of changes are included." },
];

const pill =
  "inline-block rounded-full bg-black px-3.5 py-1 text-xs font-semibold text-white hover:opacity-80 dark:bg-white dark:text-black transition";
---

<PageLayout title={SERVICES.TITLE} description={SERVICES.DESCRIPTION} fullTitle noindex>
  <Container>
    <div class="animate mb-8">
      <BackToPrev href="/">
        Back to home
      </BackToPrev>
    </div>
    <div class="space-y-14">
      <!-- Header -->
      <section class="animate space-y-5 border-b border-black/10 pb-8 dark:border-white/10">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="font-mono text-[11px] uppercase tracking-widest text-black/45 dark:text-white/45">
            Services // Price guide
          </span>
          <span class="font-mono text-[11px] text-black/45 dark:text-white/45">
            Cannock, Staffordshire
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-black dark:text-white">
          Freelance design. <span class="font-serif italic font-normal text-black/65 dark:text-white/65">Clear starting prices.</span>
        </h1>
        <p class="text-black/75 dark:text-white/75">
          Thirteen years of brand, web and app design, now open to freelance projects. Every project gets a fixed quote once we've talked it through. These are the places we start.
        </p>
      </section>

      <!-- What I do -->
      <section class="animate space-y-2">
        <SectionHeading title="01. What I do" />
        <ul class="divide-y divide-black/10 dark:divide-white/10">
          {services.map((s) => (
            <li class="flex flex-col gap-4 py-6 min-[560px]:flex-row min-[560px]:items-start min-[560px]:justify-between min-[560px]:gap-8">
              <div class="space-y-2.5">
                <h3 class="flex items-baseline gap-2.5 font-semibold text-black dark:text-white">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-black/50 dark:text-white/50">{s.letter}</span>
                  {s.title}
                </h3>
                <p class="text-sm text-black/75 dark:text-white/75">{s.blurb}</p>
                <ul class="flex flex-wrap gap-1.5">
                  {s.includes.map((item) => (
                    <li class="rounded-full border border-black/15 px-2.5 py-0.5 text-xs text-black/70 dark:border-white/15 dark:text-white/70">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex items-center justify-between gap-4 min-[560px]:flex-col min-[560px]:items-end min-[560px]:justify-start min-[560px]:shrink-0">
                <span class="font-mono text-[11px] uppercase tracking-wider text-black/65 dark:text-white/65">From {s.price}</span>
                <a href={QUOTE_HREF} class={pill} aria-label={`Get a quote for ${s.title}`}>Get a quote</a>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- How it works -->
      <section class="animate space-y-4">
        <SectionHeading title="02. How it works" />
        <dl class="grid gap-3 sm:grid-cols-[9rem_1fr] sm:gap-x-6 text-sm">
          {steps.map((step) => (
            <>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-black/50 dark:text-white/50 sm:pt-0.5">{step.label}</dt>
              <dd class="text-black/75 dark:text-white/75 -mt-2 sm:mt-0">{step.text}</dd>
            </>
          ))}
        </dl>
      </section>

      <!-- CTA -->
      <section class="animate flex flex-wrap items-center justify-between gap-4 rounded-xl border border-black/10 p-5 dark:border-white/10">
        <p class="text-sm text-black/75 dark:text-white/75 max-w-md">
          Not sure which fits? Describe the project and I'll suggest a starting point.
        </p>
        <a href={QUOTE_HREF} class={pill}>Get a quote</a>
      </section>

      <p class="animate font-mono text-[11px] text-black/55 dark:text-white/55">
        Prices are guides and may change. Tom Lowndes, sole trader.
      </p>
    </div>
  </Container>
</PageLayout>
