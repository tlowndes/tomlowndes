# Security headers for Cloudflare Pages.
# Content-Security-Policy-Report-Only reports violations in the browser console and does not block anything.
# HSTS intentionally has no preload.
# script-src hashes are sha256 of the built inline script text (leading whitespace included).
# Recompute them from dist/ if an inline script, an onclick/oninput handler, or the HTML minifier changes.
#   theme toggle (Head.astro, every page): sha256-4//1P97lyxiHC5H24/vK1hj8nY1mFxopEUlNAiVseS4=
#   astro:before-swap font-preload removal (every page): sha256-jlh3Z7NSNiaGgMz/AYl3fe12VVY0lkLIDTasn8Mb100=
#   /blog/ tag filter: sha256-DkO+U06ZG17k5AAH1JlCgcDu7PQVu0606qblx/BfdKI=
#   /contact/ form: sha256-e4l+BCGeyElprmiJGFg6nM4HCEOW7xMrtoBpGViOzR4=
#   /projects/ modal: sha256-gwiQDIvhT1tL4Lue5vKIdR2L5C9UMLSxsUSikL1xkPw=
#   /uses/ filter: sha256-CZdqihRDynp0Nx6yFUrx/AOmdQvGIDG3GvL2xroWozw=
# The other script-src hashes are the built onclick/oninput handlers on those pages.
# 'unsafe-hashes' lets those handler hashes apply. It does not allow other inline scripts.
# style-src 'unsafe-inline' covers Astro's image <style>, Shiki code colours, the honeypot style attribute,
# and the theme toggle's temporary <style> element. Fonts are self-hosted. No analytics scripts are in the build.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), bluetooth=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()
